# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Number of reverse-proxy hops to trust for client IPs (0 in local dev).
TRUST_PROXY_HOPS=0
# Comma-separated origins allowed by CORS (only needed for the Flutter web build).
CORS_ORIGINS=http://localhost:8080

# docker compose up -d  (see ../docker-compose.yml)
DATABASE_URL=postgresql://hrms:hrms@localhost:5432/hrms
# Separate database for integration tests (tables are truncated!). Must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql://hrms:hrms@localhost:5432/hrms_test
REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long-xxxxxxxx
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
TOKEN_HASH_PEPPER=change-me-at-least-32-characters-long-yyyyyyyy

# Account lockout after failed passwords (PHASE-2-FEATURES §1.3).
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

# 32 bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

MESSAGING_PROVIDER=console

# Push to managers: console (log only) or fcm (FCM_SERVICE_ACCOUNT_B64 = base64 of the Firebase service-account JSON).
PUSH_PROVIDER=console
# FCM_SERVICE_ACCOUNT_B64=

# Document storage: s3 (MinIO from docker compose, or AWS S3) or local (files under LOCAL_STORAGE_DIR, dev only).
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=hrms-documents
S3_ACCESS_KEY_ID=hrms
S3_SECRET_ACCESS_KEY=hrms-minio-secret
S3_FORCE_PATH_STYLE=true
# LOCAL_STORAGE_DIR=.storage
SIGNED_URL_TTL_SECONDS=600
MAX_UPLOAD_BYTES=10485760

# Seed (npm run db:seed)
# Bootstrap director (PHASE-2-FEATURES §1.1). Change the password at first use; production refuses weak values.
SEED_DIRECTOR_EMP_CODE=DIR001
SEED_DIRECTOR_NAME=Director
SEED_DIRECTOR_PHONE=+919000000001
SEED_DIRECTOR_PASSWORD=change-me-Director-1
SEED_DEMO=true
